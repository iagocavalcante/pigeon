# MongoDB connection string used by the server
MONGODB_URI=mongodb://localhost:27017/pigeon

# Secret used to sign/verify JWTs (auth tokens); set a real random value in production
JWT_SECRET=change-me

# Key used to encrypt per-user Resend API keys at rest (AES-256-GCM); generate with: openssl rand -hex 32
SECRETS_KEY=

# Public base URL used to build absolute links in outgoing emails (tracking, unsubscribe)
PUBLIC_URL=

# Base URL the client (Vite) uses to reach the API; leave unset to use the dev proxy / same-origin
VITE_API_URL=

# Port the server listens on
PORT=3000

# Set to "false" to disable /oauth/register once the first account exists; unset/anything else allows it
ALLOW_REGISTRATION=
